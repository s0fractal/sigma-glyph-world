{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/s0fractal/sigma-glyph-world/blob/main/experiments/scope-pilot-001/incident.schema.json",
  "title": "SCOPE-PILOT-001 evidence packet",
  "type": "object",
  "required": [
    "packet_version",
    "packet_id",
    "repository",
    "incident_date",
    "control_kind",
    "sources",
    "intended_control",
    "false_acceptance",
    "causal_chain",
    "reproducer",
    "epistemic",
    "researcher_assessment",
    "evidence_confidence"
  ],
  "properties": {
    "packet_version": {"const": 1},
    "packet_id": {"pattern": "^P[0-9]{2}$"},
    "repository": {"pattern": "^[^/]+/[^/]+$"},
    "incident_date": {"type": "string", "minLength": 4},
    "control_kind": {
      "enum": ["tests", "proofs", "static analysis", "lint/type checks", "artifact/conformance validation"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "kind", "evidence_excerpt"],
        "properties": {
          "id": {"pattern": "^E[0-9]+$"},
          "url": {"format": "uri"},
          "kind": {"enum": ["issue", "pull_request", "commit", "reproducer"]},
          "evidence_excerpt": {"type": "string", "minLength": 1}
        }
      }
    },
    "intended_control": {"type": "string", "minLength": 1},
    "false_acceptance": {"type": "string", "minLength": 1},
    "causal_chain": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["status", "claim", "evidence"],
        "properties": {
          "status": {"enum": ["FACT", "DERIVATION", "UNKNOWN"]},
          "claim": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"pattern": "^E[0-9]+$"}}
        }
      }
    },
    "reproducer": {
      "type": "object",
      "required": ["availability", "steps", "observed", "expected"],
      "properties": {
        "availability": {"enum": ["executable", "documented", "unavailable"]},
        "steps": {"type": "array", "items": {"type": "string"}},
        "observed": {"type": "string"},
        "expected": {"type": "string"}
      }
    },
    "epistemic": {
      "type": "object",
      "required": ["facts", "derivations", "unknowns"],
      "properties": {
        "facts": {"type": "array", "items": {"type": "string"}},
        "derivations": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "researcher_assessment": {
      "type": "object",
      "description": "Sampling metadata; removed from blinded render.",
      "required": ["mechanisms", "primary", "scope_controlled_by_audited_artifact", "counterclassification", "expected_multilabel"],
      "properties": {
        "mechanisms": {"type": "array", "items": {"type": "string"}},
        "primary": {"type": "string"},
        "scope_controlled_by_audited_artifact": {"enum": ["yes", "no", "unknown"]},
        "counterclassification": {
          "type": "object",
          "required": ["label", "would_be_primary_if"],
          "properties": {
            "label": {"type": "string"},
            "would_be_primary_if": {"type": "string"}
          }
        },
        "expected_multilabel": {"type": "boolean"}
      }
    },
    "evidence_confidence": {"enum": ["VERIFIED", "SUPPORTED", "TENTATIVE"]}
  }
}
